# X / Twitter API v2 — OAuth 1.0a user context (required for posting)
# Create an app at https://developer.x.com, generate keys + access tokens with
# Read + Write permissions, then fill these in.
TWITTER_API_KEY=your_consumer_key_here
TWITTER_API_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here

# Anthropic API — used by generate-drafts.js
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: override the user handle used by stats.js / shadowban check.
# If omitted, the script calls v2.me() to resolve the authenticated user.
TWITTER_USERNAME=
